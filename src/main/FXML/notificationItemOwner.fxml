            </HBox>
         </children>
      </StackPane>
      <ImageView fitHeight="100.0" fitWidth="100.0" layoutX="14.0" layoutY="10.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@img/ringBellIcon.png" />
         </image>
      </ImageView>
