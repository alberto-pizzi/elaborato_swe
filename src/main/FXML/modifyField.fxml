<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.FXML.GUIControl.ModifyFieldController">
   <children>
      <VBox alignment="CENTER" prefHeight="720.0" prefWidth="1060.0">
         <children>
            <VBox alignment="CENTER" prefHeight="72.0" prefWidth="180.0">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" text="Name:" textAlignment="CENTER" wrapText="true">
                     <font>
                        <Font size="16.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="nameInput" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="35.0" prefWidth="381.0" styleClass="text-input" stylesheets="@css/style.css">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </TextField>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="72.0" prefWidth="180.0">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" text="Price:" textAlignment="CENTER" wrapText="true">
                     <font>
                        <Font size="16.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="priceInput" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="35.0" prefWidth="381.0" styleClass="text-input" stylesheets="@css/style.css">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </TextField>
               </children>
            </VBox>
            <Label text="Description:" wrapText="true">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <TextArea fx:id="descriptionInput" prefHeight="123.0" prefWidth="1060.0" />
            <HBox alignment="CENTER" prefHeight="160.0" prefWidth="1060.0" spacing="30.0">
               <children>
                  <VBox alignment="CENTER" prefHeight="72.0" prefWidth="180.0">
                     <children>
                        <Label alignment="CENTER" contentDisplay="CENTER" text="Sports:" textAlignment="CENTER" wrapText="true">
                           <font>
                              <Font size="16.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="10.0" />
                           </VBox.margin>
                        </Label>
                        <ScrollPane prefHeight="200.0" prefWidth="200.0">
                           <VBox.margin>
                              <Insets bottom="10.0" />
                           </VBox.margin>
                           <content>
                              <VBox fx:id="sportsList" prefHeight="200.0" prefWidth="164.0" />
                           </content>
                        </ScrollPane>
                        <HBox alignment="CENTER" prefWidth="180.0" spacing="15.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#handleNewSportButton" stylesheets="@css/style.css" text="New" textFill="WHITE" wrapText="true">
                                 <styleClass>
                                    <String fx:value="button-owner" />
                                    <String fx:value="shadow" />
                                 </styleClass></Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox alignment="CENTER" prefHeight="72.0" prefWidth="180.0">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" text="Image:" textAlignment="CENTER">
                     <font>
                        <Font size="16.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </Label>
                  <ImageView fx:id="imageLabel" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
                  <Button fx:id="uploadButton" mnemonicParsing="false" onAction="#handleUploadImageButton" stylesheets="@css/style.css" text="Upload image" textFill="WHITE" wrapText="true">
                     <styleClass>
                        <String fx:value="button-owner" />
                        <String fx:value="shadow" />
                     </styleClass></Button>
               </children>
            </VBox>
            <Button fx:id="confirmButton" mnemonicParsing="false" onAction="#handleConfirmButton" stylesheets="@css/style.css" text="Confrim" textFill="WHITE" wrapText="true">
               <VBox.margin>
                  <Insets bottom="5.0" top="10.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="5.0" left="15.0" right="15.0" top="5.0" />
               </padding>
               <font>
                  <Font size="16.0" />
               </font>
               <styleClass>
                  <String fx:value="confirm-button" />
                  <String fx:value="shadow" />
               </styleClass>
            </Button>
            <Label fx:id="messageLabel" alignment="CENTER" prefHeight="25.0" prefWidth="774.0" text="Error: text" textFill="RED" visible="false" wrapText="true">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>
