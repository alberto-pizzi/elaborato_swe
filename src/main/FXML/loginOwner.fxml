<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: aeaeae;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.FXML.GUIControl.LoginOwner">
   <bottom>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </bottom>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" style="-fx-background-color: #fff; -fx-background-radius: 10;" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets left="50.0" right="50.0" top="50.0" />
         </BorderPane.margin>
         <children>
            <StackPane prefHeight="99.0" prefWidth="1180.0">
               <children>
                  <VBox alignment="CENTER" prefHeight="0.0" prefWidth="1019.0">
                     <children>
                        <Label prefHeight="70.0" prefWidth="132.0" text="Login" textAlignment="CENTER">
                           <font>
                              <Font name="System Bold" size="48.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </StackPane>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="1083.0" spacing="20.0">
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <TextField fx:id="username" prefHeight="25.0" prefWidth="485.0" promptText="Username" style="-fx-background-radius: 10px;">
                           <HBox.margin>
                              <Insets top="30.0" />
                           </HBox.margin>
                           <font>
                              <Font size="14.0" />
                           </font>
                        </TextField>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <PasswordField fx:id="password" prefHeight="25.0" prefWidth="482.0" promptText="Password" style="-fx-background-radius: 10px;">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </PasswordField>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <VBox alignment="CENTER" prefWidth="606.0">
                           <HBox.margin>
                              <Insets top="15.0" />
                           </HBox.margin>
                           <children>
                              <Label fx:id="messageLabel" alignment="CENTER" minHeight="35.0" prefHeight="35.0" prefWidth="606.0" text="Error: text" textFill="RED" visible="false" wrapText="true">
                                 <font>
                                    <Font size="16.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Button fx:id="logIn" mnemonicParsing="false" onAction="#handleLogInButton" prefHeight="168.0" prefWidth="480.0" stylesheets="@css/style.css" text="Log In" textFill="WHITE" wrapText="true">
                           <padding>
                              <Insets bottom="10.0" top="10.0" />
                           </padding>
                           <font>
                              <Font size="18.0" />
                           </font>
                           <styleClass>
                              <String fx:value="button-owner" />
                              <String fx:value="shadow" />
                           </styleClass>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets bottom="10.0" top="40.0" />
                     </VBox.margin>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0">
                     <children>
                        <Button fx:id="SignUp" mnemonicParsing="false" onAction="#handleSignUpButton" prefHeight="25.0" prefWidth="481.0" stylesheets="@css/style.css" text="Sign Up" textFill="WHITE" wrapText="true">
                           <padding>
                              <Insets bottom="10.0" top="10.0" />
                           </padding>
                           <font>
                              <Font size="18.0" />
                           </font>
                           <styleClass>
                              <String fx:value="singUp-button" />
                              <String fx:value="shadow" />
                           </styleClass>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
               <children>
                  <Button fx:id="owner" mnemonicParsing="false" onAction="#handleSwitchRoleButton" prefHeight="0.0" prefWidth="132.0" stylesheets="@css/style.css" text="I am a user" wrapText="true">
                     <padding>
                        <Insets bottom="10.0" top="10.0" />
                     </padding>
                     <font>
                        <Font size="14.0" />
                     </font>
                     <styleClass>
                        <String fx:value="loginChange-button" />
                        <String fx:value="shadow" />
                     </styleClass>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
